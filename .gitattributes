# Нормализация окончаний строк для текстовых файлов
* text=auto

# Исходники — всегда LF в репозитории
*.c      text eol=lf
*.h      text eol=lf
*.asm    text eol=lf
*.S      text eol=lf
*.ld     text eol=lf
*.conf   text eol=lf
*.cfg    text eol=lf
Makefile text eol=lf
*.md     text
*.yml    text
*.html   text

# Бинарные ассеты — без диффов и нормализации
*.bmp  binary
*.png  binary
*.jpg  binary
*.gif  binary
*.bin  binary
*.sys  binary
*.efi  binary
*.EFI  binary
boot/limine/limine binary
